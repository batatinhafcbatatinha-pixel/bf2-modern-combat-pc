{
  "repo": "bf2-modern-combat-pc",
  "game": "Battlefield 2: Modern Combat",
  "revision": "Xbox 360, USA",
  "required_files": {
    "default.xex": "a2e791b578ef15420f3737b48999ca4285fdf85c85cb6732aac0e465ed9d5484"
  },
  "required_paths": [
    "Audio",
    "Data1.viv"
  ],
  "project_dir": "project",
  "manifest": "bf2mc_manifest.toml",
  "target": "bf2mc",
  "extra_targets": [],
  "copy": [
    "project"
  ],
  "ffmpeg_dest": "project/third_party/ffmpeg/include",
  "play_args": [
    "--mnk_mode=true",
    "--mnk_mouse=false",
    "--keybind_lstick_up=W,Shift+W,Ctrl+W,Shift+Ctrl+W",
    "--keybind_lstick_down=S,Shift+S,Ctrl+S,Shift+Ctrl+S",
    "--keybind_lstick_left=A,Shift+A,Ctrl+A,Shift+Ctrl+A",
    "--keybind_lstick_right=D,Shift+D,Ctrl+D,Shift+Ctrl+D",
    "--keybind_right_trigger=LMB,Shift+LMB,Ctrl+LMB,Shift+Ctrl+LMB",
    "--keybind_left_trigger=RMB,Shift+RMB,Ctrl+RMB,Shift+Ctrl+RMB",
    "--keybind_a=Space,Shift+Space,Ctrl+Space,Shift+Ctrl+Space",
    "--keybind_b=C,Ctrl+C,Shift+C,Backspace",
    "--keybind_x=R,Shift+R,Ctrl+R,Shift+Ctrl+R",
    "--keybind_y=E,Shift+E,Ctrl+E,Shift+Ctrl+E",
    "--keybind_left_shoulder=Q,Shift+Q,Ctrl+Q,Shift+Ctrl+Q",
    "--keybind_right_shoulder=F,Shift+F,Ctrl+F,Shift+Ctrl+F",
