  "sdk": {
    "version": "0.10.0.24-dev.gbd833a2 (nightly 2026-10-02)",
    "url": "https://github.com/rexglue/rexglue-sdk/releases/download/nightly-20261002-bd833a2a/rexglue-sdk-0.10.0.24-dev.gbd833a2-win-amd64.zip",
    "sha256": "1e19d7ec9be0d9d7e1a0088a34a33b068d4dea520181e81318528ef3b37627e7",
    "folder": "win-amd64",
    "patches": [
      {
        "name": "rexglue-fpscr-mask",
        "file": "include/rex/ppc/context.h",
        "old": "  inline void setcsr(uint32_t csr) noexcept { Platform::setcsr(csr); }\n",
        "new": "  // Port patch: never let a stale/zero cached csr unmask host FP exceptions\n  // (guest threads whose csr was never seeded hit STATUS_FLOAT_INEXACT_RESULT).\n  inline void setcsr(uint32_t value) noexcept {\n    Platform::InitHostExceptions(value);\n    csr = value;\n    Platform::setcsr(value);\n  }\n"
      }
    ]
  },
