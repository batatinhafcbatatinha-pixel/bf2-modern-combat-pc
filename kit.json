    "--keybind_rstick_down=F24",
    "--keybind_rstick_left=F24",
    "--keybind_rstick_right=F24",
    "--keybind_dpad_up=Up",
    "--keybind_dpad_down=Down",
    "--keybind_dpad_left=Left",
    "--keybind_dpad_right=Right",
    "--keybind_start=Return,Escape",
    "--keybind_back=Tab"
